# =============================================================================
# Quran 13 — environment variables (TEMPLATE)
# =============================================================================
# Copy this file to `.env.local` and fill in real values for local dev.
# `.env.local` is gitignored; this template is committed so the required
# variables are documented. For production, set the same keys in your host's
# dashboard (e.g. Vercel → Project → Settings → Environment Variables) or in
# `.env.production.local`.
#
# NOTE: Everything here is a SERVER-ONLY secret *except* the two NEXT_PUBLIC_
# Supabase values at the bottom, which are designed to ship to the browser.
# Server-only vars are read in Node scripts and route handlers and must never be
# given a NEXT_PUBLIC_ prefix — that would inline them into the client bundle.
# =============================================================================

# --- Quran Foundation API (formerly the open Quran.com API) -------------------
# Register for credentials at: https://api-docs.quran.foundation  (request access)
# You get TWO credential sets: one for the "prelive" (sandbox) environment used
# in dev, and one for "production". Point the *_BASE URLs at the matching pair.
#
#   DEV  (prelive):  QF_AUTH_BASE=https://prelive-oauth2.quran.foundation
#                    QF_API_BASE=https://apis-prelive.quran.foundation
#   PROD (live):     QF_AUTH_BASE=https://oauth2.quran.foundation
#                    QF_API_BASE=https://apis.quran.foundation

QF_CLIENT_ID=your-client-id-here
QF_CLIENT_SECRET=your-client-secret-here
QF_AUTH_BASE=https://prelive-oauth2.quran.foundation
QF_API_BASE=https://apis-prelive.quran.foundation

# --- LLM provider for the natural-language navigation agent (LangChain) --------
# Used server-side by the agent route. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Supabase (cross-device sync) ---------------------------------------------
# Dashboard → Project Settings → API. These two ARE browser-safe: the publishable
# key only ever reaches data that Row Level Security already permits, and every
# synced table restricts rows to auth.uid(). Set both in the Amplify dashboard too
# — NEXT_PUBLIC_ values are inlined at build time, so they must exist during the
# build, not just at runtime.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Direct Postgres access for migrations (npm run db:migrate). SERVER-ONLY.
# Dashboard → Connect. The direct db.<ref>.supabase.co host is IPv6-only; the
# pooler host below is reachable from IPv4-only networks. Same database.
DB_CONNECTION_STRING=postgresql://postgres:PASSWORD@db.your-ref.supabase.co:5432/postgres
DB_POOLER_URL=postgresql://postgres.your-ref:PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres
